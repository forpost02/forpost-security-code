class CryptoEngine:
    """AES-256 CBC шифрование файлов"""
    
    def __init__(self, password):
        self.key = hashlib.sha256(password.encode()).digest()
        self.backend = default_backend()
    
    def encrypt(self, data):
        """Шифрует данные AES-256-CBC"""
        iv = os.urandom(16)
        cipher = Cipher(
            algorithms.AES(self.key),
            modes.CBC(iv),
            backend=self.backend
        ).encryptor()
        padder = padding.PKCS7(128).padder()
        padded = padder.update(data) + padder.finalize()
        return iv + cipher.update(padded) + cipher.finalize()
    
    def decrypt(self, data):
        """Расшифровывает данные"""
        iv = data[:16]
        cipher = Cipher(
            algorithms.AES(self.key),
            modes.CBC(iv),
            backend=self.backend
        ).decryptor()
        unpadder = padding.PKCS7(128).unpadder()
        padded = cipher.update(data[16:]) + cipher.finalize()
        return unpadder.update(padded) + unpadder.finalize()
    
    def lock_file(self, filepath):
        """Шифрует файл"""
        if not os.path.exists(filepath):
            print(f"❌ Файл не найден: {filepath}")
            return False
        
        try:
            with open(filepath, "rb") as f:
                data = f.read()
            
            encrypted = self.encrypt(data)
            
            with open(filepath + ".locked", "wb") as f:
                f.write(base64.b64encode(encrypted))
            
            print(f"🔒 ЗАШИФРОВАН: {filepath}")
            print(f"   → {filepath}.locked")
            return True
        except Exception as e:
            print(f"❌ Ошибка шифрования: {e}")
            return False
    
    def unlock_file(self, filepath):
        """Расшифровывает файл"""
        if not filepath.endswith(".locked"):
            print("❌ Файл должен заканчиваться на .locked")
            return False
        
        if not os.path.exists(filepath):
            print(f"❌ Файл не найден: {filepath}")
            return False
        
        try:
            with open(filepath, "rb") as f:
                data = base64.b64decode(f.read())
            
            decrypted = self.decrypt(data)
            original = filepath.replace(".locked", "")
            
            with open(original, "wb") as f:
                f.write(decrypted)
            
            print(f"🔓 РАСШИФРОВАН: {original}")
            return True
        except Exception as e:
            print(f"❌ Ошибка расшифровки: {e}")
            return False

