class DDoSShield:
    """Базовый DDoS Shield с мониторингом соединений"""
    
    def __init__(self):
        self.blocked = set()
        self.counts = {}
        self.running = False
    
    def start(self, duration=60):
        """Мониторит соединения и блокирует подозрительные IP"""
        print("┌─────────────────────────────────────────────────┐")
        print("│         DDoS SHIELD АКТИВИРОВАН                 │")
        print(f"│         Мониторинг: {duration} секунд                    │")
        print("└─────────────────────────────────────────────────┘")
        print()
        
        self.running = True
        start_time = time.time()
        
        while time.time() - start_time < duration and self.running:
            try:
                with open("/proc/net/tcp", "r") as f:
                    lines = f.readlines()[1:]
                
                for line in lines:
                    parts = line.split()
                    if len(parts) >= 8 and parts[3] == "01":
                        try:
                            ip_raw = bytes.fromhex(parts[2].split(":")[0])
                            ip = socket.inet_ntoa(ip_raw[::-1])
                            
                            if ip in ("0.0.0.0", "127.0.0.1"):
                                continue
                            
                            self.counts[ip] = self.counts.get(ip, 0) + 1
                            
                            if self.counts[ip] > 100 and ip not in self.blocked:
                                self.blocked.add(ip)
                                print(f"🚫 ЗАБЛОКИРОВАН: {ip} ({self.counts[ip]} пакетов)")
                        except Exception:
                            pass
            except Exception:
                pass
            
            time.sleep(1)
        
        print()
        print(f"✅ Shield завершён. Заблокировано IP: {len(self.blocked)}")

