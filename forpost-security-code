class IPAnalyzer:
    """Анализ IP-адресов через API"""
    
    def analyze(self, ip):
        """Получает информацию об IP"""
        print(f"🔍 АНАЛИЗ IP: {ip}")
        print("─" * 50)
        
        try:
            from urllib.request import urlopen, Request
            
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            
            req = Request(
                f"http://ip-api.com/json/{ip}",
                headers={"User-Agent": "Forpost/1.0"}
            )
            response = urlopen(req, context=ctx, timeout=5)
            data = json.loads(response.read().decode())
            
            print(f"   🌍 Страна:   {data.get('country', '?')}")
            print(f"   🏙  Город:    {data.get('city', '?')}")
            print(f"   📡 ISP:      {data.get('isp', '?')}")
            print(f"   🏢 Орг:      {data.get('org', '?')}")
            print(f"   🔒 Прокси:   {'ДА ⚠️' if data.get('proxy') else 'НЕТ ✅'}")
            print(f"   🖥  Хостинг: {'ДА ⚠️' if data.get('hosting') else 'НЕТ ✅'}")
            print(f"   🕐 Часовой:  {data.get('timezone', '?')}")
            print("─" * 50)
        except Exception as e:
            print(f"   ❌ Ошибка: {e}")

